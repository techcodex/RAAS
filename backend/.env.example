APP_NAME=RAAS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local (no Docker) defaults to sqlite; docker-compose overrides to pgsql.
DB_CONNECTION=sqlite
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=raas
DB_USERNAME=raas
DB_PASSWORD=raas

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploaded documents live on the S3-compatible disk (MinIO locally).
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / MinIO (local dev credentials — override in production).
AWS_ACCESS_KEY_ID=raas
AWS_SECRET_ACCESS_KEY=raassecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=raas-documents
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/raas-documents
AWS_USE_PATH_STYLE_ENDPOINT=true

# rag-service (Python chunking/embedding microservice).
RAG_SERVICE_URL=http://rag-service:8001
RAG_INTERNAL_SECRET=change-me-to-a-long-random-string

VITE_APP_NAME="${APP_NAME}"
